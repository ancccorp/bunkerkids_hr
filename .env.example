# 복사해서 .env.local 로 저장하세요. 값이 비어 있으면 개발 모드(구성원 선택 로그인 + 데모 데이터)로 동작합니다.
# 운영(Vercel)에서는 이 파일 대신 Vercel 프로젝트 설정 > Environment Variables 에 같은 이름으로 넣습니다.

# 데이터베이스 (Supabase > Connect > Direct > Transaction pooler, 포트 6543)
# 비우면 로컬 내장 DB(PGlite, data/pglite)를 씁니다. Vercel 에서는 필수입니다.
DATABASE_URL=

# Google Workspace 로그인 (Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID, 웹 애플리케이션)
# 승인된 리디렉션 URI: {APP_URL}/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 이 도메인 계정만 로그인 허용
ALLOWED_EMAIL_DOMAIN=bunkerkids.net
# 서비스 주소 (리디렉션 URI 생성용)
APP_URL=https://hr.example.com
# 세션 서명 키, 32자 이상 랜덤 문자열 (예: openssl rand -hex 32)
AUTH_SECRET=
# 최초 배포 시 관리자로 자동 등록할 이메일 (관리자가 한 명도 없을 때만 동작)
BOOTSTRAP_ADMIN_EMAIL=

# 데모 데이터 강제 여부 (기본: Google 미설정 시에만 데모)
# SEED_DEMO=false
# 로컬 내장 DB 저장 폴더 (기본 data/pglite, DATABASE_URL 이 없을 때만 사용)
# HR_DB_PATH=./data/pglite
# DB 연결 풀 크기 (기본 5)
# DB_POOL_MAX=5
